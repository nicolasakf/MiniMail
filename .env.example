# Copy this file to .env.local (git-ignored) and fill in what you need, then rebuild.
# Values are inlined into the main process at build time (electron-vite MAIN_VITE_ prefix).
# None of these are required: without them you can still use Gmail/Zoho app passwords.

# Google sign-in (Gmail). Create an OAuth client of type "Desktop app".
MAIN_VITE_GOOGLE_CLIENT_ID=
MAIN_VITE_GOOGLE_CLIENT_SECRET=

# Microsoft sign-in (Outlook personal + work/school). Azure app registration client id.
MAIN_VITE_MICROSOFT_CLIENT_ID=
