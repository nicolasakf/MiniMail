{
  "name": "minimail",
  "version": "0.18.0",
  "description": "Desktop email client with a unified inbox and categories you define in plain language",
  "private": true,
  "license": "Apache-2.0",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
